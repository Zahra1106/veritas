# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or MongoDB Atlas free tier)
MONGO_URI=mongodb://127.0.0.1:27017/veritas

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Hugging Face free inference API (get a free token at https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx
# Free public model for AI-generated image detection
HF_IMAGE_MODEL=Organika/sdxl-detector

# Upload limits
MAX_UPLOAD_MB=50

# Cloudinary (free tier) - required for evidence file storage on Vercel,
# since Vercel's filesystem is temporary/read-only in production.
# Sign up free at https://cloudinary.com, then find these on your dashboard.
CLOUDINARY_CLOUD_NAME=dyacw4bca
CLOUDINARY_API_KEY=167732919985231
CLOUDINARY_API_SECRET=OwRm2hW2SUdv0CvZyJFk49v91yQ